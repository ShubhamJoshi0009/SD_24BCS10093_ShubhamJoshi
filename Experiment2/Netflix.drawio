<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="netflix_hld_diagram" name="Netflix System Design HLD">
    <mxGraphModel dx="1471" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="req" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1: Functional &amp;amp; Non-Functional Requirements&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Functional:&lt;/b&gt;&lt;br&gt;- Upload Videos (Content Creators/Backend)&lt;br&gt;- Search &amp;amp; Discover videos&lt;br&gt;- Stream videos smoothly&lt;br&gt;&lt;br&gt;&lt;b&gt;Non-Functional:&lt;/b&gt;&lt;br&gt;- High Availability (99.999% uptime)&lt;br&gt;- Extremely Low Latency (Zero buffering)&lt;br&gt;- High Scalability (Handles millions concurrently)&lt;br&gt;- High Reliability (No data loss for uploads)" vertex="1">
          <mxGeometry height="240" width="260" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="est" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2: Back of the Envelope Estimation&lt;/b&gt;&lt;br&gt;&lt;br&gt;- &lt;b&gt;Total Users:&lt;/b&gt; ~250 Million&lt;br&gt;- &lt;b&gt;Daily Active Users (DAU):&lt;/b&gt; ~100 Million&lt;br&gt;- &lt;b&gt;Watch Time:&lt;/b&gt; ~2 hours/day per user&lt;br&gt;- &lt;b&gt;Video Size:&lt;/b&gt; ~3 GB per hour (HD)&lt;br&gt;&lt;br&gt;&lt;b&gt;Bandwidth Estimate:&lt;/b&gt;&lt;br&gt;100M users * 2 hrs * 3GB = &lt;b&gt;600 Petabytes / day&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Storage Estimate:&lt;/b&gt;&lt;br&gt;Thousands of titles in multiple codecs &amp;amp; resolutions = &lt;b&gt;Petabytes of raw &amp;amp; processed storage.&lt;/b&gt;" vertex="1">
          <mxGeometry height="240" width="280" x="310" y="30" as="geometry" />
        </mxCell>
        <mxCell id="comp" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;3: Components Used&lt;/b&gt;&lt;br&gt;&lt;br&gt;- &lt;b&gt;Clients:&lt;/b&gt; Web, Mobile, Smart TV&lt;br&gt;- &lt;b&gt;CDN:&lt;/b&gt; Netflix Open Connect (OCA)&lt;br&gt;- &lt;b&gt;Load Balancer:&lt;/b&gt; AWS ELB / HAProxy&lt;br&gt;- &lt;b&gt;API Gateway:&lt;/b&gt; Zuul API Gateway&lt;br&gt;- &lt;b&gt;Microservices:&lt;/b&gt; Auth, Catalog, Search&lt;br&gt;- &lt;b&gt;Databases:&lt;/b&gt; Cassandra, ElasticSearch&lt;br&gt;- &lt;b&gt;Cache:&lt;/b&gt; Redis / EVCache&lt;br&gt;- &lt;b&gt;Storage:&lt;/b&gt; AWS S3 (Raw &amp;amp; Encoded)&lt;br&gt;- &lt;b&gt;Event Bus / Analytics:&lt;/b&gt; Apache Kafka &amp;amp; Hadoop" vertex="1">
          <mxGeometry height="240" width="240" x="610" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;4: Flow and Connections&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Control Plane:&lt;/b&gt; Client requests (login, search, thumbnails) hit the Load Balancer -&amp;gt; API Gateway. Gateway routes to specific microservices.&lt;br&gt;&lt;b&gt;2. Data/Streaming Plane:&lt;/b&gt; When a user hits &quot;Play&quot;, the client gets a URL directly to the nearest &lt;b&gt;Netflix Open Connect (CDN)&lt;/b&gt; server to stream video, bypassing the backend.&lt;br&gt;&lt;b&gt;3. Ingestion Plane:&lt;/b&gt; New content is uploaded to S3 -&amp;gt; Picked up by Transcoders (AWS EC2) to convert into various bitrates/resolutions -&amp;gt; Pushed to Processed S3 -&amp;gt; Distributed globally to CDN.&lt;br&gt;&lt;b&gt;4. Analytics:&lt;/b&gt; All user events (pause, play, search) are streamed to Kafka for Big Data ML processing to generate personalized recommendations." vertex="1">
          <mxGeometry height="240" width="310" x="870" y="30" as="geometry" />
        </mxCell>
        <mxCell id="backend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f9fa;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontStyle=1;fontSize=14;" value="AWS Cloud / Backend Control Plane" vertex="1">
          <mxGeometry height="320" width="570" x="580" y="340" as="geometry" />
        </mxCell>
        <mxCell id="ingest_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f9fa;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontStyle=1;fontSize=14;" value="Video Ingestion &amp; Processing Plane" vertex="1">
          <mxGeometry height="150" width="760" x="190" y="720" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;" value="&lt;b&gt;Clients&lt;/b&gt;&lt;br&gt;(Web, Mobile, TV)" vertex="1">
          <mxGeometry height="60" width="120" x="50" y="470" as="geometry" />
        </mxCell>
        <mxCell id="cdn" parent="1" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;spacing=10;" value="&lt;b&gt;Netflix Open Connect&lt;/b&gt;&lt;br&gt;(Global CDN)" vertex="1">
          <mxGeometry height="100" width="160" x="340" y="310" as="geometry" />
        </mxCell>
        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;" value="&lt;b&gt;Load Balancer&lt;/b&gt;&lt;br&gt;(AWS ELB)" vertex="1">
          <mxGeometry height="60" width="120" x="260" y="470" as="geometry" />
        </mxCell>
        <mxCell id="apigw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;(Zuul)" vertex="1">
          <mxGeometry height="60" width="110" x="430" y="470" as="geometry" />
        </mxCell>
        <mxCell id="usvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;" value="&lt;b&gt;User / Auth Service&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="140" x="620" y="390" as="geometry" />
        </mxCell>
        <mxCell id="csvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;" value="&lt;b&gt;Catalog / Metadata&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="140" x="620" y="475" as="geometry" />
        </mxCell>
        <mxCell id="ssvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;" value="&lt;b&gt;Search Service&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="140" x="620" y="560" as="geometry" />
        </mxCell>
        <mxCell id="cass" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;" value="&lt;b&gt;Cassandra&lt;/b&gt;&lt;br&gt;(Profiles/State)" vertex="1">
          <mxGeometry height="80" width="90" x="840" y="375" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;(EVCache)" vertex="1">
          <mxGeometry height="80" width="90" x="980" y="460" as="geometry" />
        </mxCell>
        <mxCell id="es" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;" value="&lt;b&gt;ElasticSearch&lt;/b&gt;&lt;br&gt;(Search Index)" vertex="1">
          <mxGeometry height="80" width="90" x="840" y="545" as="geometry" />
        </mxCell>
        <mxCell id="kafka" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;(Event Stream)" vertex="1">
          <mxGeometry height="60" width="130" x="625" y="760" as="geometry" />
        </mxCell>
        <mxCell id="hadoop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;" value="&lt;b&gt;Hadoop / Spark&lt;/b&gt;&lt;br&gt;(Data Lake / ML)" vertex="1">
          <mxGeometry height="60" width="120" x="825" y="760" as="geometry" />
