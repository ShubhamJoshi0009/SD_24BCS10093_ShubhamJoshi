<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="netflix_hld_diagram" name="Netflix System Design HLD">
    <mxGraphModel dx="1471" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="req" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1: Requirements&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Functional:&lt;/b&gt;&lt;br&gt;• Upload Videos (Creators/Backend)&lt;br&gt;• Search &amp;amp; Discover catalog&lt;br&gt;• Stream adaptive bitrate video&lt;br&gt;&lt;br&gt;&lt;b&gt;Non-Functional:&lt;/b&gt;&lt;br&gt;• High Availability (99.999%)&lt;br&gt;• Ultra-low Latency (Fast playback)&lt;br&gt;• Scalable to millions concurrently&lt;br&gt;• High Durability (Zero upload loss)" vertex="1">
          <mxGeometry height="260" width="270" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="est" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2: Estimations&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Total Users:&lt;/b&gt; ~250M&lt;br&gt;• &lt;b&gt;DAU:&lt;/b&gt; ~100M active&lt;br&gt;• &lt;b&gt;Watch Time:&lt;/b&gt; ~2 hrs/day/user&lt;br&gt;• &lt;b&gt;Stream Rate:&lt;/b&gt; ~3 GB/hr (HD)&lt;br&gt;&lt;br&gt;&lt;b&gt;Bandwidth Estimate:&lt;/b&gt;&lt;br&gt;100M × 2h × 3GB = &lt;b&gt;600 PB / day&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Storage Estimate:&lt;/b&gt;&lt;br&gt;Multiple encodings &amp;amp; resolutions = &lt;b&gt;Petabytes distributed&lt;/b&gt;" vertex="1">
          <mxGeometry height="260" width="270" x="320" y="30" as="geometry" />
        </mxCell>
        <mxCell id="comp" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;3: Components&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Edge CDN:&lt;/b&gt; Netflix Open Connect&lt;br&gt;• &lt;b&gt;Gateway:&lt;/b&gt; AWS ELB + Zuul&lt;br&gt;• &lt;b&gt;Services:&lt;/b&gt; Auth, Catalog, Search&lt;br&gt;• &lt;b&gt;Databases:&lt;/b&gt; Cassandra, ElasticSearch&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; EVCache / Redis&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; AWS S3 (Raw &amp;amp; Encoded)&lt;br&gt;• &lt;b&gt;Analytics:&lt;/b&gt; Kafka + Apache Spark" vertex="1">
          <mxGeometry height="260" width="270" x="610" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;verticalAlign=top;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;4: Core Architecture Flows&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Control Plane:&lt;/b&gt; App client hits ELB → Zuul Gateway → routes queries to Microservices &amp;amp; DBs.&lt;br&gt;&lt;b&gt;2. Streaming Plane:&lt;/b&gt; Playback requests directly pull chunks from nearest &lt;b&gt;Open Connect CDN&lt;/b&gt; edge.&lt;br&gt;&lt;b&gt;3. Video Ingestion:&lt;/b&gt; Creators upload raw video to S3 → Transcoders generate chunks → Stored in Processed S3 → Distributed to Open Connect.&lt;br&gt;&lt;b&gt;4. Analytics:&lt;/b&gt; User actions stream via Kafka to Spark/Hadoop for ML recommendations." vertex="1">
          <mxGeometry height="260" width="340" x="900" y="30" as="geometry" />
        </mxCell>
        <mxCell id="backend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f9fa;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontStyle=1;fontSize=14;" value="AWS Cloud / Backend Control Plane" vertex="1">
          <mxGeometry height="340" width="600" x="600" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ingest_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f9fa;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontStyle=1;fontSize=14;" value="Video Ingestion &amp; Processing Plane" vertex="1">
          <mxGeometry height="160" width="870" x="200" y="700" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;fontStyle=1;" value="Clients&lt;br&gt;&lt;span style=&quot;font-weight: 400; font-size: 11px;&quot;&gt;(Web, Mobile, TV)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="130" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="cdn" parent="1" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;spacing=8;fontStyle=1;" value="Netflix Open Connect&lt;br&gt;&lt;span style=&quot;font-weight: 400; font-size: 11px;&quot;&gt;(Global Edge CDN)&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="330" y="320" as="geometry" />
        </mxCell>
        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;fontStyle=1;" value="Load Balancer&lt;br&gt;&lt;span style=&quot;font-weight: 400; font-size: 11px;&quot;&gt;(AWS ELB)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="130" x="230" y="470" as="geometry" />
        </mxCell>
        <mxCell id="apigw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;fontStyle=1;" value="API Gateway&lt;br&gt;&lt;span style=&quot;font-weight: 400; font-size: 11px;&quot;&gt;(Zuul)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="410" y="470" as="geometry" />
        </mxCell>
        <mxCell id="usvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontStyle=1;" value="User / Auth Service" vertex="1">
