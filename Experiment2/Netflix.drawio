        <mxCell id="creator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;shadow=1;" value="&lt;b&gt;Content Creator /&lt;br&gt;Studio Upload&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="130" x="30" y="750" as="geometry" />
        </mxCell>
        <mxCell id="ingest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;shadow=1;" value="&lt;b&gt;Ingestion Service&lt;/b&gt;&lt;br&gt;(Validator/Queue)" vertex="1">
          <mxGeometry height="60" width="130" x="280" y="750" as="geometry" />
        </mxCell>
        <mxCell id="raws3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;" value="&lt;b&gt;Raw S3 Bucket&lt;/b&gt;&lt;br&gt;(Master Video)" vertex="1">
