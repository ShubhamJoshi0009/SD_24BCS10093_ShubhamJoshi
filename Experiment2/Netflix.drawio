        </mxCell>
        <mxCell id="csvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontStyle=1;" value="Catalog / Metadata" vertex="1">
          <mxGeometry height="50" width="150" x="640" y="465" as="geometry" />
        </mxCell>
        <mxCell id="ssvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontStyle=1;" value="Search Service" vertex="1">
